# Sorabbyngo Sentinel OS — Buildroot defconfig
# Hardened security operations variant of Sorabbyngo OS
# Inherits from sorabbyngo_x86_64_defconfig + security overlays

# Architecture
BR2_x86_64=y
BR2_x86_corei7=y

# Toolchain
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_KERNEL_HEADERS_6_6=y

# Kernel — upstream for now, switch to sorabbyngo patches for production
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_LATEST_VERSION=y
BR2_LINUX_KERNEL_USE_DEFCONFIG=y
BR2_LINUX_KERNEL_DEFCONFIG="x86_64"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y

# Init
BR2_INIT_BUSYBOX=y
BR2_TARGET_GENERIC_HOSTNAME="sorabbyngo-sentinel"
BR2_TARGET_GENERIC_ISSUE="Sorabbyngo Sentinel OS — Security Operations"
BR2_TARGET_GENERIC_ROOT_PASSWD="sentinel"
BR2_TARGET_GENERIC_PASSWD_SHA256=y

# Locale
BR2_ENABLE_LOCALE=y
BR2_GENERATE_LOCALE="en_US.UTF-8"

# Core packages
BR2_PACKAGE_BASH=y
BR2_PACKAGE_PYTHON3=y
BR2_PACKAGE_PYTHON3_SSL=y
BR2_PACKAGE_PYTHON_PIP=y
BR2_PACKAGE_BUSYBOX=y
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_OPENSSH=y
BR2_PACKAGE_CA_CERTIFICATES=y
BR2_PACKAGE_IPROUTE2=y
BR2_PACKAGE_WGET=y

# Security tools
BR2_PACKAGE_NMAP=y
BR2_PACKAGE_TCPDUMP=y
BR2_PACKAGE_WIRESHARK=y
BR2_PACKAGE_NETCAT=y
BR2_PACKAGE_STRACE=y
BR2_PACKAGE_GDB=y
BR2_PACKAGE_FILE=y
BR2_PACKAGE_BINUTILS=y

# Forensics
BR2_PACKAGE_DD_RESCUE=y
BR2_PACKAGE_SLEUTHKIT=y

# Sorabbyngo overlay
BR2_ROOTFS_OVERLAY="board/sorabbyngo-sentinel/overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="board/sorabbyngo-sentinel/post-build.sh"

# Output
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="4G"
BR2_TARGET_ROOTFS_ISO9660=y
BR2_TARGET_ROOTFS_ISO9660_HYBRID=y
BR2_TARGET_GRUB2=y
BR2_TARGET_GRUB2_X86_64_EFI=y
